# Defaults pra rodar CCWS. Em container, todas as variaveis sao
# sobrescritas pelo docker-compose.yml do TV30 (service `ccws`).
#
# Required (server falha no boot se faltar): MQTT_HOST, REDIS_HOST,
# HTTPS_KEY, HTTPS_CERT, JWT_SECRET, USER_DATA_FILE, USER_THUMBS

# [REQUIRED] Hostname do broker MQTT. Em container = nome do service ('mosquitto').
# Fora de container = localhost (broker rodando no host).
MQTT_HOST=localhost

# Portas. Compose mapeia 44652:44652 (HTTP) e 44653:44653 (HTTPS).
HTTP_PORT=44652
HTTPS_PORT=44653

# [REQUIRED] Redis (estado de sessao + users). Em container = service 'redis'.
REDIS_HOST=localhost
REDIS_PORT=6379

# [REQUIRED] Diretorio com userData.json + thumbs/. Em container = /user-files
# (volume montado de ./user-files na raiz do TV30).
USER_DATA_FILE=/user-files/userData.json
USER_THUMBS=/user-files/thumbs

# Metadados de descoberta do webservice. Opcional, defaults internos.
# BRAND_NAME='GenericBrand'
# MODEL='GenericModel'
# FRIENDLY_NAME='TV 3.0 Receiver'
# UDN='uuid:TV30-1234-5678-9012-345678901234'

# [REQUIRED] JWT — usar valores fortes em producao.
JWT_SECRET=changeme
JWT_ISSUER=GenericIssuer

# [REQUIRED] Chaves HTTPS em base64 (RSA + X.509). Gerar com:
#   openssl req -newkey rsa:2048 -nodes -keyout server.key -x509 -days 365 -out server.crt
# e converter pra base64.
HTTPS_KEY=
HTTPS_CERT=

# Logging: ERROR | INFO | DEBUG (default ERROR)
LOG_LEVEL=ERROR
